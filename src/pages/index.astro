---
// Startsidan – omdesignad 2026-08-22 enligt designunderlaget: personlig
// hero med två huvudhandlingar, förtroenderad, snabbval för resmål och
// personlig avsändare. Verktygen ska dominera; guiderna är fördjupning.
import { Picture } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Ikon from "../components/Ikon.astro";
import Sektionslinje from "../components/Sektionslinje.astro";
import PackningIllustration from "../components/PackningIllustration.astro";
import { siteName, siteDescription, sitePages } from "../config/site";
import heroBild from "../assets/hero-familj.png";

// Ikon per fördjupningskort (samma DNA som hero-bilden).
const kortIkon: Record<string, "glob" | "sim" | "varning" | "checklista" | "ordbok"> = {
  "/guider/ringa-utomlands/": "glob",
  "/guider/esim-for-nyborjare/": "sim",
  "/guider/roaming-utanfor-eu/": "varning",
  "/guider/basta-abonnemang-resa/": "checklista",
  "/ordlista/": "ordbok",
};

const title = "Ringa.se – Ringa & surfa utomlands utan chockfaktura";
const description =
  "Se vad roaming kan kosta på ditt resmål, ta reda på om telefonen stöder eSIM och få tydliga råd inför resan – på begriplig svenska.";

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteName,
  url: "https://ringa.se/",
  description: siteDescription,
  inLanguage: "sv",
  publisher: {
    "@type": "Organization",
    name: siteName,
    url: "https://ringa.se/",
    description: siteDescription,
  },
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: siteName,
  url: "https://ringa.se/",
  description: siteDescription,
};

const guider = sitePages.filter((p) => p.section === "guider");
const ordlista = sitePages.filter((p) => p.section === "ordlista");
const lander = sitePages.filter((p) => p.section === "lander");

const snabbval = [
  { id: "thailand", name: "Thailand" },
  { id: "usa", name: "USA" },
  { id: "turkiet", name: "Turkiet" },
  { id: "storbritannien", name: "Storbritannien" },
  { id: "eu", name: "Inom EU/EES" },
  { id: "annat", name: "Annat land utanför EU" },
];
---

<BaseLayout
  title={title}
  description={description}
  schema={[websiteSchema, organizationSchema]}
>
  <div class="home">
    <section class="hero">
      <div>
        <h1>Res med mobilen – utan dyra överraskningar</h1>
        <p class="hero-ingress">
          Se vad roaming kan kosta på ditt resmål, ta reda på om telefonen
          stöder eSIM och få tydliga råd inför resan.
        </p>
        {/* Handlingslänkar, inte knappar: båda navigerar bara vidare i sajten.
            En knapp signalerar "något körs", vilket oroade besökare inför
            eSIM-kollaren. Understruken länk + pil signalerar förflyttning. */}
        <p class="cta-row">
          <a class="hero-lank" href="/verktyg/roamingkalkylator/">
            <Ikon namn="kalkylator" storlek={20} /> Räkna på min resa
            <span class="pil" aria-hidden="true">→</span>
          </a>
          <a class="hero-lank" href="/verktyg/esim-kollare/">
            <Ikon namn="mobil-ok" storlek={20} /> Funkar eSIM i min telefon?
            <span class="pil" aria-hidden="true">→</span>
          </a>
        </p>
        <p class="hero-trust">
          Oberoende guider · Faktagranskat varje månad · Inga spårningscookies
        </p>
      </div>
      {/* Illustration levererad av designanalytikern (se docs/licenser.md).
          Dekorativ intill hero-texten → tom alt. Hero-bilden är sidans LCP,
          därför eager + hög prioritet. */}
      <Picture
        src={heroBild}
        alt=""
        formats={["avif"]}
        fallbackFormat="webp"
        widths={[480, 760, 1100]}
        sizes="(max-width: 44rem) 92vw, 40vw"
        loading="eager"
        fetchpriority="high"
        class="hero-bild"
      />
    </section>

    <ul class="trust-row">
      <li>
        <Ikon namn="granskad" />
        <div>
          <span class="trust-label">Faktagranskat</span>
          <span class="trust-desc">Kontrolleras varje månad</span>
        </div>
      </li>
      <li>
        <Ikon namn="oberoende" />
        <div>
          <span class="trust-label">Oberoende råd</span>
          <span class="trust-desc">Officiella källor prioriteras</span>
        </div>
      </li>
      <li>
        <Ikon namn="annonsmarkning" />
        <div>
          <span class="trust-label">Öppen finansiering</span>
          <span class="trust-desc">
            <a href="/om/sa-tjanar-vi-pengar/">Annonslänkar märks tydligt</a>
          </span>
        </div>
      </li>
      <li>
        <Ikon namn="integritet" />
        <div>
          <span class="trust-label">Integritet</span>
          <span class="trust-desc">
            <a href="/om/integritet-cookies/">Inga spårningscookies</a>
          </span>
        </div>
      </li>
    </ul>

    <h2>Vart ska du resa?</h2>
    <p>
      Välj resmål så räknar kalkylatorn direkt på vad mobilen kan kosta där –
      och om ett eSIM är värt det.
    </p>
    <ul class="pill-row">
      {
        snabbval.map((land) => (
          <li>
            <a class="pill" href={`/verktyg/roamingkalkylator/?land=${land.id}`}>
              {land.name}
            </a>
          </li>
        ))
      }
    </ul>

    <h2>Populära resmål</h2>
    <ul class="card-grid">
      {
        lander.map((p) => (
          <li>
            <a class="card" href={p.path}>
              <strong>{p.title}</strong>
              <p>{p.description}</p>
            </a>
          </li>
        ))
      }
    </ul>

    <Sektionslinje />
    <h2>Så fungerar det</h2>
    <ol class="steps">
      <li>
        <Ikon namn="resmal" storlek={32} />
        <strong>Välj resmål</strong>
        <p>
          Berätta vart du ska och hur länge – i kalkylatorn eller via
          snabbvalen ovan.
        </p>
      </li>
      <li>
        <Ikon namn="kalkylator" storlek={32} />
        <strong>Se vad det kostar</strong>
        <p>
          Du får ett ärligt kostnadsspann för operatörsroaming respektive
          rese-eSIM, med beräkningen öppet redovisad.
        </p>
      </li>
      <li>
        <Ikon namn="mobil-ok" storlek={32} />
        <strong>Res med rätt lösning</strong>
        <p>
          Följ råden i landsguiden – och kolla först att telefonen stöder eSIM
          i <a href="/verktyg/esim-kollare/">eSIM-kollaren</a>.
        </p>
      </li>
    </ol>

    <PackningIllustration />

    <section class="founder">
      <blockquote>
        ”Jag tyckte själv att det var onödigt svårt att förstå vad mobilen
        faktiskt skulle kosta utomlands. Därför byggde jag Ringa.se – med
        räkneverktyg, källor på bordet och utan en enda spårningscookie.”
      </blockquote>
      <p class="founder-sign">
        – Niclas, grundare. <a href="/om/">Mer om Ringa.se och hur sajten
        hålls aktuell.</a>
      </p>
    </section>

    <Sektionslinje />
    <h2>Fördjupning: guider och ordlista</h2>
    <ul class="card-grid">
      {
        [...guider, ...ordlista].map((p) => (
          <li>
            <a class="card card-med-ikon" href={p.path}>
              <Ikon namn={kortIkon[p.path] ?? "glob"} storlek={26} />
              <strong>{p.title}</strong>
              <p>{p.description}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
