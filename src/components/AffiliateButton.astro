---
// [KRAV] Knappkomponent för affiliatelänkar. Renderar alltid ordet
// "Annonslänk" i direkt anslutning till knappen (MFL 9 §, IAB Sveriges
// rekommendation) och rel="sponsored noopener" (Googles krav för betalda
// länkar). Märkningen ligger ovanför knappen enligt designbeslut
// 2026-08-23. Får inte ändras av agentpipelinen.
import { partners, type PartnerKey } from "../config/partners";

interface Props {
  /** Nyckel i partners.ts – enda tillåtna sättet att peka ut målet. */
  partner: PartnerKey;
  /** Knapptext, t.ex. "Se Airalos eSIM för Thailand". */
  text: string;
}

const { partner, text } = Astro.props;
const target = partners[partner];
---

<p class="affiliate-button-wrap">
  <span class="affiliate-label">Annonslänk · {target.label}</span>
  <a class="affiliate-button" href={target.url} rel="sponsored noopener">
    {text}
  </a>
</p>
