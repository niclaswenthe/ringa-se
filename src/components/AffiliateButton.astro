---
// [KRAV] Knappkomponent för affiliatelänkar. Renderar alltid ordet
// "Annonslänk" i direkt anslutning till knappen (MFL 9 §, IAB Sveriges
// rekommendation) och rel="sponsored noopener" (Googles krav för betalda
// länkar). Märkningen ligger ovanför knappen enligt designbeslut
// 2026-08-23. Får inte ändras av agentpipelinen.
import { partners, affiliateUrl, type PartnerKey } from "../config/partners";

interface Props {
  /** Nyckel i partners.ts – enda tillåtna sättet att peka ut målet. */
  partner: PartnerKey;
  /** Knapptext, t.ex. "Se Airalos eSIM för Thailand". */
  text: string;
  /** Djuplänksnyckel, t.ex. "thailand". Utan den används standardlänken. */
  mal?: string;
}

const { partner, text, mal } = Astro.props;
const target = partners[partner];
const href = affiliateUrl(partner, mal);
---

<p class="affiliate-button-wrap">
  <span class="affiliate-label" aria-hidden="true">
    Annonslänk · {target.label}
  </span>
  {/* Märkningen ingår i länkens tillgängliga namn så att den hörs även
      vid länknavigering i skärmläsare (och den visuella etiketten döljs
      för skärmläsare så att den inte läses dubbelt). Den synliga
      knapptexten ingår ordagrant i namnet (WCAG 2.5.3 Label in Name). */}
  <a
    class="affiliate-button"
    href={href}
    rel="sponsored noopener"
    aria-label={`Annonslänk: ${text}`}
  >
    {text}
  </a>
</p>
