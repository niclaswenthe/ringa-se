---
// Ringa.se:s logotyp (koncept 2026-08-23, rev 2): korallinjen – resvägen –
// löper huvudsakligen horisontellt under ordmärket och viker av med en
// kort mjuk uppgång till punkten i ".se" – destinationspunkten, samma
// signatur som i hero-bilden. Medvetet geometrisk/digital snarare än
// böjd, för att undvika leende-association (TUI). Linje och punkt är
// integrerade delar av SVG:n, inte dekor utanpå.
// Typsnittet är systemstacken (sajtens medvetna val); textLength låser
// bredden så att kompositionen håller oavsett plattformens font.
// Dekorativ – länken som omger logotypen bär det tillgängliga namnet.
interface Props {
  /** Höjd i px; bredden följer proportionerligt. */
  hojd?: number;
}
const { hojd = 30 } = Astro.props;
const bredd = Math.round((hojd * 156) / 44);
---

<svg
  class="logotyp"
  viewBox="0 0 156 44"
  width={bredd}
  height={hojd}
  aria-hidden="true"
>
  <text
    x="0"
    y="31"
    textLength="97"
    lengthAdjust="spacingAndGlyphs"
    font-family="system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
    font-size="32"
    font-weight="800"
    letter-spacing="-0.5"
    fill="#17324D">Ringa</text>
  {/* Rak linje; endast sista biten gör en kort mjuk uppgång och går
      direkt in i punktens nedre vänstra kant. Punkten är optiskt
      i storlek med i-punkten i ordmärket. */}
  <path
    d="M2 39.5 H94 Q99.5 39.5 102.2 32.3"
    fill="none"
    stroke="#D96B55"
    stroke-width="2.3"
    stroke-linecap="round"></path>
  <circle cx="104.5" cy="30.5" r="3.1" fill="#D96B55"></circle>
  <text
    x="114"
    y="31"
    textLength="34"
    lengthAdjust="spacingAndGlyphs"
    font-family="system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
    font-size="32"
    font-weight="800"
    letter-spacing="-0.5"
    fill="#0B5CAD">se</text>
</svg>
