---
// Hero-illustration v2 – efter analytikerns bildriktning (2026-08-23):
// familj i ankomstögonblicket, begränsad palett (marinblå/sand/ljusblå/
// korall), rundade SIM-kortsinspirerade former i bakgrunden och en tunn
// korallinje som startar vid mobilen och slutar i en destinationspunkt –
// tänkt som återkommande designelement. Egenritad flat SVG: inga foton,
// ingen licensrisk, någon KB stor. Figurerna är medvetet ansiktslösa.
// Dekorativ intill hero-texten → aria-hidden.
//
// Två kompositioner: full scen för desktop och tätare beskärning för
// mobil (samma scen via <use>, olika viewBox).
---

<svg
  class="hero-illustration hero-illustration-desktop"
  viewBox="0 0 900 620"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <g id="hero-scen">
    <!-- Bakgrund: varm sandton med rundade hörn -->
    <rect x="0" y="0" width="900" height="620" rx="36" fill="#FAF6EF"></rect>

    <!-- Terminalfönster: stor rundad ljusblå yta med inre glasruta -->
    <rect x="48" y="36" width="600" height="320" rx="42" fill="#EAF3FA"></rect>
    <rect x="84" y="66" width="380" height="200" rx="28" fill="#F4F9FD"></rect>

    <!-- SIM-kortsform: rundad rektangel med klippt hörn -->
    <path
      d="M770 190 L858 190 Q880 190 880 212 L880 428 Q880 450 858 450 L740 450 Q718 450 718 428 L718 242 Z"
      fill="#DCEBF7"
    ></path>

    <!-- Växt -->
    <ellipse cx="112" cy="432" rx="13" ry="34" fill="#BBD7EC" transform="rotate(-24 112 432)"></ellipse>
    <ellipse cx="146" cy="422" rx="13" ry="38" fill="#AECFE8" transform="rotate(4 146 422)"></ellipse>
    <ellipse cx="176" cy="436" rx="12" ry="30" fill="#BBD7EC" transform="rotate(26 176 436)"></ellipse>
    <rect x="108" y="462" width="76" height="64" rx="14" fill="#9FC2DE"></rect>

    <!-- Golv -->
    <path d="M0 522 H900 V584 Q900 620 864 620 H36 Q0 620 0 584 Z" fill="#F1E7D6"></path>

    <!-- ===== Mamman (vänster) ===== -->
    <!-- hår: svep bakom ena axeln -->
    <path d="M268 178 Q272 146 300 144 Q330 146 333 180 Q338 224 330 258 Q322 276 306 268 Q318 230 314 196 L286 196 Q280 240 262 262 Q252 240 258 210 Q260 190 268 178 Z" fill="#1B2B3F"></path>
    <circle cx="300" cy="196" r="26" fill="#C98D63"></circle>
    <path d="M273 192 Q274 158 300 156 Q326 158 327 192 Q319 172 300 172 Q281 172 273 192 Z" fill="#1B2B3F"></path>
    <!-- kappa -->
    <path d="M262 234 Q300 218 338 234 L347 424 Q300 436 254 424 Z" fill="#EDE2CF"></path>
    <rect x="287" y="234" width="26" height="58" rx="9" fill="#ffffff"></rect>
    <!-- axelväska i korall -->
    <path d="M266 246 L242 330" stroke="#C25A45" stroke-width="7" stroke-linecap="round"></path>
    <rect x="216" y="326" width="62" height="76" rx="10" fill="#D96B55"></rect>
    <!-- arm mot resväskans handtag -->
    <path d="M338 252 Q370 288 376 356" stroke="#EDE2CF" stroke-width="16" stroke-linecap="round" fill="none"></path>
    <circle cx="377" cy="362" r="9" fill="#C98D63"></circle>
    <!-- ben -->
    <rect x="278" y="434" width="18" height="98" rx="8" fill="#24344A"></rect>
    <rect x="304" y="434" width="18" height="98" rx="8" fill="#24344A"></rect>
    <!-- resväska -->
    <path d="M354 368 V440 M402 368 V440" stroke="#1D3A5F" stroke-width="7"></path>
    <rect x="346" y="356" width="64" height="13" rx="6" fill="#1D3A5F"></rect>
    <rect x="340" y="434" width="76" height="108" rx="11" fill="#26436B"></rect>

    <!-- ===== Barnet (mitten, framför) ===== -->
    <circle cx="470" cy="302" r="22" fill="#B97A4E"></circle>
    <path d="M449 298 Q448 266 470 264 Q492 266 491 298 Q484 280 470 280 Q456 280 449 298 Z" fill="#14243A"></path>
    <ellipse cx="494" cy="322" rx="9" ry="19" fill="#14243A" transform="rotate(18 494 322)"></ellipse>
    <!-- randig tröja -->
    <rect x="446" y="330" width="48" height="98" rx="8" fill="#ffffff"></rect>
    <rect x="446" y="344" width="48" height="7" fill="#24405E"></rect>
    <rect x="446" y="360" width="48" height="7" fill="#24405E"></rect>
    <rect x="446" y="376" width="48" height="7" fill="#24405E"></rect>
    <rect x="446" y="392" width="48" height="7" fill="#24405E"></rect>
    <!-- hoodie-sidor -->
    <rect x="432" y="326" width="15" height="110" rx="7" fill="#F3EBDD"></rect>
    <rect x="493" y="326" width="15" height="110" rx="7" fill="#F3EBDD"></rect>
    <!-- arm mot lilla väskan -->
    <path d="M498 352 Q516 386 520 424" stroke="#F3EBDD" stroke-width="12" stroke-linecap="round" fill="none"></path>
    <circle cx="521" cy="428" r="7" fill="#B97A4E"></circle>
    <!-- ben -->
    <rect x="455" y="436" width="15" height="98" rx="7" fill="#2B4A70"></rect>
    <rect x="474" y="436" width="15" height="98" rx="7" fill="#2B4A70"></rect>
    <!-- liten resväska -->
    <path d="M508 432 V474 M544 432 V474" stroke="#D9C9A8" stroke-width="6"></path>
    <rect x="500" y="422" width="52" height="11" rx="5" fill="#D9C9A8"></rect>
    <rect x="496" y="470" width="60" height="82" rx="10" fill="#EFE3D0"></rect>
    <rect x="536" y="524" width="11" height="15" rx="3" fill="#D96B55"></rect>

    <!-- ===== Pappan (höger, håller mobilen) ===== -->
    <circle cx="626" cy="168" r="27" fill="#8A5A3B"></circle>
    <path d="M598 166 Q595 132 626 130 Q657 132 654 166 Q649 158 644 152 Q636 158 622 150 Q610 156 604 152 Q600 158 598 166 Z" fill="#12233A"></path>
    <!-- jacka -->
    <path d="M584 208 Q626 192 668 208 L677 404 Q626 418 575 404 Z" fill="#17324D"></path>
    <rect x="608" y="212" width="36" height="76" rx="10" fill="#ffffff"></rect>
    <!-- armar mot mobilen -->
    <path d="M584 244 Q558 292 596 304" stroke="#17324D" stroke-width="17" stroke-linecap="round" fill="none"></path>
    <path d="M668 244 Q666 292 642 302" stroke="#17324D" stroke-width="17" stroke-linecap="round" fill="none"></path>
    <!-- mobil -->
    <rect x="598" y="282" width="27" height="46" rx="6" fill="#1D2733"></rect>
    <rect x="602" y="288" width="19" height="34" rx="3" fill="#EAF3FA"></rect>
    <circle cx="600" cy="306" r="8" fill="#8A5A3B"></circle>
    <circle cx="638" cy="302" r="8" fill="#8A5A3B"></circle>
    <!-- ben -->
    <rect x="600" y="416" width="20" height="116" rx="9" fill="#1F2C3D"></rect>
    <rect x="630" y="416" width="20" height="116" rx="9" fill="#1F2C3D"></rect>
    <!-- stor resväska -->
    <path d="M706 342 V410 M774 342 V410" stroke="#16304E" stroke-width="7"></path>
    <rect x="698" y="330" width="84" height="13" rx="6" fill="#16304E"></rect>
    <rect x="688" y="404" width="104" height="146" rx="12" fill="#1D3A5F"></rect>
    <rect x="756" y="508" width="16" height="19" rx="4" fill="#D96B55"></rect>

    <!-- Korallinjen: resvägen – startar vid mobilen, slutar i destination -->
    <circle cx="611" cy="280" r="5" fill="#D96B55"></circle>
    <path
      d="M611 278 Q672 236 738 196 Q806 154 836 118"
      fill="none"
      stroke="#D96B55"
      stroke-width="5"
      stroke-linecap="round"
    ></path>
    <circle cx="842" cy="110" r="11" fill="#D96B55"></circle>
    <circle cx="842" cy="110" r="4" fill="#FAF6EF"></circle>
  </g>
</svg>

<svg
  class="hero-illustration hero-illustration-mobil"
  viewBox="230 60 620 560"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <use href="#hero-scen"></use>
</svg>
