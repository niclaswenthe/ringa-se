---
// Dekorativ hero-illustration: ankomstögonblicket – framme, mobilen funkar,
// semestern kan börja. Egen flat SVG i sajtens palett (inga foton, ingen
// licensrisk, ingen LCP-kostnad). Figurerna är medvetet förenklade och
// ansiktslösa. aria-hidden: bilden är dekorativ.
---

<svg
  class="hero-illustration"
  viewBox="0 0 560 420"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <!-- Himmel -->
  <rect x="0" y="0" width="560" height="420" rx="24" fill="#EAF3FA"></rect>
  <!-- Sol -->
  <circle cx="92" cy="84" r="34" fill="#F5C26B"></circle>
  <!-- Moln -->
  <ellipse cx="420" cy="70" rx="52" ry="16" fill="#ffffff"></ellipse>
  <ellipse cx="470" cy="88" rx="38" ry="13" fill="#ffffff"></ellipse>
  <ellipse cx="180" cy="120" rx="44" ry="13" fill="#ffffff"></ellipse>
  <!-- Flygplan på väg bort -->
  <g fill="#17324D" opacity="0.85">
    <path d="M330 52 l46 10 -6 8 -48 -6 -18 14 -9 -2 12 -16 -12 -10 8 -4 16 6 z"></path>
  </g>
  <!-- Mark -->
  <path d="M0 330 q140 -26 280 0 t280 0 v66 a24 24 0 0 1 -24 24 h-512 a24 24 0 0 1 -24 -24 z" fill="#F7F1E8"></path>

  <!-- Resväska stor -->
  <g>
    <rect x="216" y="272" width="50" height="70" rx="8" fill="#D96B55"></rect>
    <rect x="232" y="258" width="18" height="16" rx="5" fill="none" stroke="#17324D" stroke-width="5"></rect>
    <line x1="230" y1="272" x2="230" y2="342" stroke="#c25a45" stroke-width="4"></line>
    <line x1="252" y1="272" x2="252" y2="342" stroke="#c25a45" stroke-width="4"></line>
  </g>
  <!-- Resväska liten -->
  <g>
    <rect x="436" y="292" width="40" height="52" rx="7" fill="#17324D"></rect>
    <rect x="436" y="310" width="40" height="9" fill="#F7F1E8"></rect>
    <rect x="448" y="282" width="16" height="12" rx="4" fill="none" stroke="#17324D" stroke-width="4"></rect>
  </g>

  <!-- Figur A: håller mobilen -->
  <g>
    <circle cx="312" cy="204" r="17" fill="#8D5A3B"></circle>
    <path d="M290 226 a22 22 0 0 1 44 0 v58 a8 8 0 0 1 -8 8 h-28 a8 8 0 0 1 -8 -8 z" fill="#17324D"></path>
    <rect x="298" y="292" width="11" height="50" rx="5" fill="#2b3b4d"></rect>
    <rect x="315" y="292" width="11" height="50" rx="5" fill="#2b3b4d"></rect>
    <!-- Arm mot mobilen -->
    <rect x="330" y="238" width="26" height="10" rx="5" fill="#17324D"></rect>
    <!-- Mobil -->
    <rect x="352" y="228" width="18" height="32" rx="4" fill="#1d2733"></rect>
    <rect x="355" y="232" width="12" height="24" rx="2" fill="#EAF3FA"></rect>
  </g>
  <!-- Figur B: tittar på skärmen -->
  <g>
    <circle cx="398" cy="214" r="15" fill="#E8B48C"></circle>
    <path d="M379 234 a19 19 0 0 1 38 0 v52 a8 8 0 0 1 -8 8 h-22 a8 8 0 0 1 -8 -8 z" fill="#0B5CAD"></path>
    <rect x="384" y="292" width="10" height="50" rx="5" fill="#2b3b4d"></rect>
    <rect x="400" y="292" width="10" height="50" rx="5" fill="#2b3b4d"></rect>
  </g>

  <!-- Pratbubbla: allt funkar -->
  <g>
    <circle cx="382" cy="176" r="24" fill="#ffffff"></circle>
    <path d="M374 190 l8 8 6 -8 z" fill="#ffffff"></path>
    <path d="M371 176 l8 8 15 -16" fill="none" stroke="#1d6f42" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"></path>
  </g>
</svg>
