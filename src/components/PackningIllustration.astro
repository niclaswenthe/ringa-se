---
// Mindre kompletterande illustration: förberedelser före avresa.
// Stilleben utan människor – resväska, mobil med eSIM-QR och pass – i
// samma visuella DNA som hero-bilden (palett, rundade former, korallinje
// med destinationspunkt). Dekorativ → aria-hidden.
---

<svg
  class="packning-illustration"
  viewBox="0 0 460 250"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <!-- Bakgrundsplatta med SIM-hörna -->
  <path
    d="M28 12 H400 L448 60 V218 a20 20 0 0 1 -20 20 H28 a20 20 0 0 1 -20 -20 V32 a20 20 0 0 1 20 -20 Z"
    fill="#FAF6EF"
  ></path>
  <!-- Golvskugga -->
  <ellipse cx="230" cy="216" rx="170" ry="12" fill="#F1E7D6"></ellipse>

  <!-- Resväska -->
  <path d="M78 96 V70 M148 96 V70" stroke="#16304E" stroke-width="6"></path>
  <rect x="70" y="60" width="86" height="12" rx="6" fill="#16304E"></rect>
  <rect x="58" y="92" width="110" height="122" rx="13" fill="#1D3A5F"></rect>
  <rect x="58" y="136" width="110" height="12" fill="#26436B"></rect>
  <rect x="132" y="182" width="15" height="18" rx="4" fill="#D96B55"></rect>

  <!-- Mobil med eSIM-QR -->
  <rect x="206" y="72" width="86" height="142" rx="12" fill="#17324D"></rect>
  <rect x="214" y="86" width="70" height="114" rx="6" fill="#ffffff"></rect>
  <g fill="#24405E">
    <rect x="224" y="106" width="14" height="14" rx="2"></rect>
    <rect x="260" y="106" width="14" height="14" rx="2"></rect>
    <rect x="224" y="142" width="14" height="14" rx="2"></rect>
    <rect x="244" y="112" width="8" height="8" rx="1.5"></rect>
    <rect x="246" y="128" width="12" height="8" rx="1.5"></rect>
    <rect x="228" y="128" width="10" height="8" rx="1.5"></rect>
    <rect x="264" y="128" width="8" height="8" rx="1.5"></rect>
    <rect x="246" y="146" width="8" height="10" rx="1.5"></rect>
    <rect x="262" y="144" width="12" height="12" rx="2"></rect>
  </g>
  <rect x="228" y="92" width="42" height="7" rx="3.5" fill="#EAF3FA"></rect>
  <!-- bock -->
  <circle cx="284" cy="204" r="17" fill="#ffffff"></circle>
  <circle cx="284" cy="204" r="17" fill="none" stroke="#EAF3FA" stroke-width="2"></circle>
  <path d="M276 204 l5.5 5.5 10-10.5" fill="none" stroke="#1D6F42" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"></path>

  <!-- Pass -->
  <rect x="330" y="118" width="74" height="96" rx="9" fill="#26436B"></rect>
  <circle cx="367" cy="156" r="16" fill="none" stroke="#F1E7D6" stroke-width="3"></circle>
  <rect x="349" y="186" width="36" height="6" rx="3" fill="#F1E7D6"></rect>

  <!-- Korallinjen: från mobilen mot destinationen -->
  <circle cx="292" cy="76" r="4" fill="#D96B55"></circle>
  <path
    d="M292 74 Q330 46 372 40 Q408 36 424 30"
    fill="none"
    stroke="#D96B55"
    stroke-width="4"
    stroke-linecap="round"
  ></path>
  <circle cx="430" cy="28" r="8" fill="#D96B55"></circle>
  <circle cx="430" cy="28" r="3" fill="#FAF6EF"></circle>
</svg>
