---
// Sidhuvud: horisontell meny på desktop, kompakt logotyp + menyknapp på
// mobil (~64 px). Mobilmenyn är en <details>-utfällning – fungerar helt
// utan JavaScript och stänger sig själv vid sidbyte.
import { Image } from "astro:assets";
import logotyp from "../assets/logotyp.png";

const nav = [
  { path: "/guider/ringa-utomlands/", label: "Stora guiden" },
  { path: "/verktyg/esim-kollare/", label: "eSIM-kollaren" },
  { path: "/verktyg/roamingkalkylator/", label: "Kalkylatorn" },
  { path: "/ordlista/", label: "Ordlista" },
  { path: "/om/", label: "Om" },
];

const current = Astro.url.pathname;
---

<a class="skip-link" href="#huvudinnehall">Hoppa till innehållet</a>
<header class="site-header">
  <div class="container header-inner">
    {/* Ägarens levererade ordmärke (original i src/assets/logotyp.png).
        Dekorativ bild – länken bär det tillgängliga namnet. */}
    <a class="site-logo" href="/" aria-label="Ringa.se – till startsidan">
      <Image
        src={logotyp}
        alt=""
        height={34}
        densities={[1, 2, 3]}
        loading="eager"
        class="logotyp"
      />
    </a>
    <nav class="site-nav" aria-label="Huvudmeny">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a
                href={item.path}
                aria-current={current === item.path ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <details class="mobilmeny">
      <summary>
        <svg
          width="20"
          height="20"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M3 5 H17 M3 10 H17 M3 15 H17"></path>
        </svg>
        Meny
      </summary>
      <nav aria-label="Mobilmeny">
        <ul>
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.path}
                  aria-current={current === item.path ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>
